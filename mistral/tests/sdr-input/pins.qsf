set_location_assignment PIN_V11 -to FPGA_CLK1_50
set_location_assignment PIN_Y15 -to DATA
set_location_assignment PIN_W15 -to OBSERVED
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to DATA
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to OBSERVED
set_instance_assignment -name FAST_INPUT_REGISTER ON -to DATA
