set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name OPTIMIZE_IOC_REGISTER_PLACEMENT_FOR_TIMING OFF
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_location_assignment PIN_V11 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_location_assignment PIN_V12 -to a
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to a
set_location_assignment PIN_AF7 -to b
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to b
set_location_assignment PIN_W12 -to c
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to c
set_location_assignment PIN_AF8 -to d
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to d
set_location_assignment PIN_Y8 -to e
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to e
set_location_assignment PIN_AB4 -to h
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to h
set_location_assignment PIN_Y15 -to q[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to q[0]
set_location_assignment PIN_AC24 -to q[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to q[1]
set_location_assignment PIN_AA15 -to q[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to q[2]
set_location_assignment PIN_AD26 -to q[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to q[3]
set_location_assignment LABCELL_X30_Y20_N0 -to f
set_location_assignment LABCELL_X30_Y20_N3 -to g
set_location_assignment FF_X30_Y20_N1 -to r0
set_location_assignment FF_X30_Y20_N2 -to r1
set_location_assignment FF_X30_Y20_N4 -to r2
set_location_assignment FF_X30_Y20_N5 -to r3

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"