set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name SDC_FILE clocks.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "PASSIVE SERIAL"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_location_assignment PIN_W21 -to CLK_W21
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLK_W21
set_location_assignment PIN_W15 -to LED
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "pll8|*"
set_location_assignment FRACTIONALPLL_X89_Y1_N0 -to "pll8|general[0].gpll~FRACTIONAL_PLL"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y6_N1 -to "pll8|general[0].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y7_N1 -to "pll8|general[1].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y5_N1 -to "pll8|general[2].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y8_N1 -to "pll8|general[3].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y0_N1 -to "pll8|general[4].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y1_N1 -to "pll8|general[5].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y2_N1 -to "pll8|general[6].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y3_N1 -to "pll8|general[7].gpll~PLL_OUTPUT_COUNTER"
