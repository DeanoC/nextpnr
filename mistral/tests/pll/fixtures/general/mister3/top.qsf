set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name SDC_FILE clocks.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION OFF
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "PASSIVE SERIAL"
set_global_assignment -name ENABLE_CONFIGURATION_PINS OFF
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2
set_location_assignment PIN_V11 -to FPGA_CLK1_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK1_50
set_location_assignment PIN_Y13 -to FPGA_CLK2_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK2_50
set_location_assignment PIN_E11 -to FPGA_CLK3_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to FPGA_CLK3_50
set_location_assignment PIN_W15 -to LED
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LED
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "pll_audio|*"
set_location_assignment FRACTIONALPLL_X0_Y32_N0 -to "pll_audio|general[0].gpll~FRACTIONAL_PLL"
set_location_assignment PLLOUTPUTCOUNTER_X0_Y33_N1 -to "pll_audio|general[0].gpll~PLL_OUTPUT_COUNTER"
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "pll_core|*"
set_location_assignment FRACTIONALPLL_X89_Y1_N0 -to "pll_core|general[0].gpll~FRACTIONAL_PLL"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y6_N1 -to "pll_core|general[0].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y7_N1 -to "pll_core|general[1].gpll~PLL_OUTPUT_COUNTER"
set_location_assignment PLLOUTPUTCOUNTER_X89_Y5_N1 -to "pll_core|general[2].gpll~PLL_OUTPUT_COUNTER"
set_instance_assignment -name PLL_COMPENSATION_MODE DIRECT -to "pll_hdmi|*"
set_location_assignment FRACTIONALPLL_X0_Y15_N0 -to "pll_hdmi|general[0].gpll~FRACTIONAL_PLL"
set_location_assignment PLLOUTPUTCOUNTER_X0_Y20_N1 -to "pll_hdmi|general[0].gpll~PLL_OUTPUT_COUNTER"
