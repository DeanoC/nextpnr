set_location_assignment PIN_V11 -to clk
set_location_assignment PIN_AF4 -to rst_n
set_location_assignment PIN_AH3 -to ce_n
set_location_assignment PIN_V12 -to d[0]
set_location_assignment PIN_E8 -to d[1]
set_location_assignment PIN_W12 -to d[2]
set_location_assignment PIN_D11 -to d[3]
set_location_assignment PIN_AH27 -to dq[0]
set_location_assignment PIN_AG25 -to dq[1]
set_location_assignment PIN_AH26 -to dq[2]
set_location_assignment PIN_AF25 -to dq[3]
set_location_assignment PIN_Y15 -to q[0]
set_location_assignment PIN_AC24 -to q[1]
set_location_assignment PIN_AA15 -to q[2]
set_location_assignment PIN_AD26 -to q[3]
