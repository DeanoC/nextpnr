set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY top
set_global_assignment -name VERILOG_FILE top.v
set_global_assignment -name SDC_FILE clocks.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_location_assignment PIN_V11 -to clk
set_instance_assignment -name VIRTUAL_PIN ON -to din[*]
set_instance_assignment -name VIRTUAL_PIN ON -to dout[*]
set_global_assignment -name REMOVE_DUPLICATE_REGISTERS OFF
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"
set_location_assignment LABCELL_X29_Y77_N30 -to y5
set_location_assignment LABCELL_X29_Y77_N30 -to lut5~SUM_OUT
set_location_assignment LABCELL_X29_Y77_N30 -to lut5~COUT
set_location_assignment LABCELL_X29_Y77_N30 -to lut5~SHAREOUT
set_location_assignment LABCELL_X29_Y77_N36 -to y6
set_location_assignment LABCELL_X29_Y77_N36 -to lut6~SUM_OUT
set_location_assignment LABCELL_X29_Y77_N36 -to lut6~COUT
set_location_assignment LABCELL_X29_Y77_N36 -to lut6~SHAREOUT
set_location_assignment FF_X29_Y77_N31 -to dout[0]~reg0
set_location_assignment FF_X29_Y77_N37 -to dout[1]~reg0
set_location_assignment FF_X29_Y77_N41 -to q[0]
set_location_assignment FF_X29_Y77_N35 -to q[1]
set_location_assignment FF_X29_Y77_N14 -to q[2]
set_location_assignment FF_X29_Y77_N23 -to q[3]
set_location_assignment FF_X29_Y77_N20 -to q[4]
set_location_assignment FF_X29_Y77_N17 -to q[5]
set_location_assignment IOIBUF_X32_Y0_N1 -to clk~input
set_instance_assignment -name IO_STANDARD "2.5 V" -to clk
set_location_assignment LABCELL_X30_Y77_N0 -to dout[0]
set_location_assignment LABCELL_X30_Y77_N39 -to dout[1]
set_location_assignment LABCELL_X30_Y77_N12 -to din[0]
set_location_assignment LABCELL_X30_Y77_N21 -to din[1]
set_location_assignment LABCELL_X30_Y77_N24 -to din[2]
set_location_assignment LABCELL_X30_Y77_N33 -to din[3]
set_location_assignment LABCELL_X30_Y77_N6 -to din[4]
set_location_assignment LABCELL_X30_Y77_N45 -to din[5]
set_location_assignment LABCELL_X85_Y2_N3 -to ~QUARTUS_CREATED_GND~I
set_location_assignment CLKCTRL_G6 -to clk~inputCLKENA0
set_global_assignment -name ROUTING_BACK_ANNOTATION_FILE top.rcf