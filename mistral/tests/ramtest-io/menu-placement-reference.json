  "runner_source": "import gzip,hashlib,json,subprocess,time\nfrom pathlib import Path\nROOT=Path('/tmp/nextpnr-135-investigation/menu-placement-study')\nFIXTURE=Path('/home/deano/kepler/worktrees/nextpnr-mistral-sdram-timing-reliability-54cde5d3/mistral/tests/gpurouter/menu_ddr_seed1')\nEXE=Path('/tmp/nextpnr-135-build/nextpnr-mistral')\ndef sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()\nROOT.mkdir(exist_ok=False)\n(ROOT/'runner-source.py').write_bytes(Path(__file__).read_bytes())\n(ROOT/'plan.json').write_text(json.dumps({'fixture':'retained menu DDR; independent of RAM tester and Atari ST','seeds':[1,2],'weight':10,'exponents':[7,2],'analogue_target_ps':500,'analogue_rounds':5,'timeout_seconds':240,'acceptance':'retain every run, compare final analogue setup/hold and complete exit status; no hardware claim'},indent=2)+'\\n')\nfor seed in [1,2]:\n for exponent in [7,2]:\n  out=ROOT/f'seed{seed}-c{exponent}';out.mkdir()\n  (out/'synth.json').write_bytes(gzip.decompress((FIXTURE/'synth.json.gz').read_bytes()))\n  for name in ['constraints.qsf','clocks.sdc']:(out/name).write_bytes((FIXTURE/name).read_bytes())\n  cmd=[str(EXE),'--device','5CSEBA6U23I7','--json',str(out/'synth.json'),'--qsf',str(out/'constraints.qsf'),'--sdc',str(out/'clocks.sdc'),'--freq','74.25','--seed',str(seed),'--router','gpu','--gpu-cpu','--placer-heap-timingweight','10','--placer-heap-critexp',str(exponent),'--gpu-opt','analogueSlack=500','--gpu-opt','analogueRipSlack=500','--gpu-opt','analogueRounds=5','--write',str(out/'final.json'),'--report',str(out/'timing.json'),'--detailed-timing-report','--rbf',str(out/'core.rbf'),'--compress-rbf']\n  (out/'command.json').write_text(json.dumps(cmd,indent=2)+'\\n')\n  start=time.monotonic();status='complete'\n  with (out/'build.log').open('w') as log:\n   try:code=subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,timeout=240).returncode\n   except subprocess.TimeoutExpired:code=None;status='timeout'\n  d={'seed':seed,'exponent':exponent,'weight':10,'status':status,'compiler_returncode':code,'elapsed_seconds':time.monotonic()-start,'nextpnr_sha256':sha(EXE),'runner_sha256':sha(ROOT/'runner-source.py'),'command':cmd,'files':{p.name:sha(p) for p in out.iterdir() if p.is_file()},'hardware_tested':False}\n  if code is not None and (out/'timing.json').exists():\n   d['timing_summary']=json.loads((out/'timing.json').read_text()).get('timing_summary')\n   assert d['timing_summary'] and d['timing_summary']['final_analogue_model']\n   d['complete_timing_pass']=code==0 and all(c['setup_wns_ns']>=0 and c['hold_wns_ns']>=0 for c in d['timing_summary']['clocks'].values())\n  (out/'receipt.json').write_text(json.dumps(d,indent=2)+'\\n')\n  print(json.dumps({k:d[k] for k in ['seed','exponent','status','compiler_returncode','elapsed_seconds']}),flush=True)\n",
